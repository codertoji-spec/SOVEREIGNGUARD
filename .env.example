# ============================================================
# SOVEREIGNGUARD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual credentials.
# ============================================================

PORT=3000
NODE_ENV=development

# ------------------------------------------------------------
# SPONSOR 1: NUTRIENT (Document Fact & Page Extraction)
# Sign up at: https://www.nutrient.io
# ------------------------------------------------------------
NUTRIENT_API_KEY=your_nutrient_api_key_here
NUTRIENT_ENDPOINT=https://api.nutrient.io/extraction/parse

# ------------------------------------------------------------
# SPONSOR 2: SERPAPI (Independent Market Grounding & Search)
# Sign up at: https://serpapi.com
# ------------------------------------------------------------
SERPAPI_API_KEY=your_serpapi_api_key_here

# ------------------------------------------------------------
# SPONSOR 3: DOCTAVIAN (Deterministic Contract Generation)
# Sign up at: https://portal.doctavian.com
# ------------------------------------------------------------
DOCTAVIAN_API_KEY=your_doctavian_api_key_here
DOCTAVIAN_BEARER_TOKEN=your_doctavian_oauth_bearer_token_here
DOCTAVIAN_ENDPOINT=https://demo.api.doctavian.com

# ------------------------------------------------------------
# SPONSOR 4: FOXIT (Document Generation & Legal Boundary)
# Sign up at: https://fusion.foxit.com / https://esign.foxit.com
# ------------------------------------------------------------
FOXIT_CLIENT_ID=your_foxit_client_id_here
FOXIT_CLIENT_SECRET=your_foxit_client_secret_here
FOXIT_ENDPOINT=https://na1.fusion.foxit.com/document-generation/api/GenerateDocumentBase64
